@page "/"

<PageTitle>Dashboard</PageTitle>

<h1>Dashboard</h1>

<AuthorizeView>
    <p class="lead">Welcome back, @context.User.FindFirstValue(ClaimTypes.GivenName)!</p>
</AuthorizeView>

<div class="row g-3">
    <div class="col-sm-6 col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Rentals</h2>
                <p class="card-text text-body-secondary">Browse rental units and their photos.</p>
                <a class="btn btn-primary" href="rentals">Go to rentals</a>
            </div>
        </div>
    </div>
</div>
